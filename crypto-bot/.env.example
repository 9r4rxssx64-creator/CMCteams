# ============================================================
#  CONFIG BOT CRYPTO — copie ce fichier en ".env" et remplis-le
#  Le fichier .env est IGNORÉ par git (tes clés restent chez toi)
#
#  ⚠️ Ci-dessous : le préréglage AGRESSIF +++ (Kevin 2026-09-11), celui
#  réellement déployé sur les 6 bots de la flotte (testnet + 5 papier).
#  Il ne touche JAMAIS TESTNET, PAPER, ni les clés — argent réel toujours
#  hors de portée d'un simple réglage. Les garde-fous (stop, plafond de
#  perte/jour, drawdown, frein catastrophe, kill switch) restent TOUS actifs,
#  juste recalibrés plus larges pour laisser respirer des positions plus
#  grosses — jamais retirés. Pour revenir au réglage prudent d'origine,
#  les anciennes valeurs sont notées en commentaire à côté de chacune.
# ============================================================

# --- Clés API Binance ---
# IMPORTANT : sur Binance, quand tu crées la clé API,
#   ✅ coche "Enable Spot Trading"
#   ❌ NE COCHE JAMAIS "Enable Withdrawals" (retraits)
#   ✅ restreins la clé à ton adresse IP si possible
# Pour le TESTNET : crée tes clés sur https://testnet.binance.vision
BINANCE_API_KEY=colle_ta_cle_ici
BINANCE_API_SECRET=colle_ton_secret_ici

# --- Sécurité : mode testnet (faux argent) ---
# true  = faux argent (par défaut, aucun risque) — commence TOUJOURS ici
# false = ARGENT RÉEL (ne passe à false qu'après validation en testnet)
TESTNET=true
# PAPER=true : portefeuille 100% virtuel (10 000 USDT), aucune clé requise.
# Utilisé par les 5 bots "papier" de la flotte (p1-p5) — pas par le principal.
PAPER=false
BOT_NAME=bot   # étiquette dans les logs (utile en flotte multi-bots)

# --- Marché & rythme ---
# SYMBOLS : une ou plusieurs paires séparées par des virgules (toutes en USDT).
# Le capital est réparti à parts égales entre les paires choisies.
# (Réglable aussi depuis le tableau de bord bot.kd-mc.com.)
SYMBOLS=BTC/USDT
# ex multi-cryptos : SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=3m        # agressif +++ (était 15m) : signal réévalué toutes les 3 min
# Intervalle entre deux vérifications (secondes)
LOOP_SECONDS=30     # agressif +++ (était 60) : réagit plus vite à un signal

# --- Choix de la stratégie ---
# ema     = croisement de moyennes mobiles (suit la tendance)
# meanrev = retour à la moyenne (achète les creux, marchés plats/sans tendance)
# dipup   = achat de creux EN tendance haussière (le plus prudent des trois)
STRATEGY=ema

# --- Stratégie EMA (croisement EMA + filtre RSI + stop ATR) ---
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_MAX=85          # agressif +++ (était 70) : filtre à peine, laisse passer plus de croisements
ATR_PERIOD=14
ATR_STOP_MULT=1.3   # agressif +++ (était 2.0) : stop plus serré = position plus grosse à risque égal

# --- Stratégie retour à la moyenne (meanrev) ---
MR_PERIOD=20         # période SMA / écart-type des bandes
MR_STD_MULT=1.5      # agressif +++ (était 2.0) : bandes plus étroites = signaux plus fréquents
MR_RSI_BUY=45        # agressif +++ (était 35) : achète des creux moins profonds
MR_RSI_SELL=55       # agressif +++ (était 60) : prend le profit plus tôt

# --- Stratégie achat de creux en tendance haussière (dipup) ---
DU_TREND_PERIOD=50   # EMA de tendance de fond
DU_RSI_BUY=45        # agressif +++ (était 35) : achète des creux moins profonds
DU_RSI_SELL=55       # agressif +++ (était 60) : encaisse le rebond plus tôt

# --- Politique de sortie ---
# true = ne JAMAIS vendre une position à perte, attendre la remontée
#        (le stop-loss ATR est alors désactivé pour cette position — voir
#        CATASTROPHE_STOP_PCT ci-dessous pour garder un vrai filet de sécurité)
HOLD_UNTIL_PROFIT=false
MIN_PROFIT_PCT=0.3   # marge mini au-dessus du prix d'entrée pour vendre (si HOLD_UNTIL_PROFIT)
# Frein catastrophe : même en HOLD_UNTIL_PROFIT, on force la vente si la
# position s'effondre au-delà de -X% (0 = jamais — DANGEREUX en agressif si
# HOLD_UNTIL_PROFIT=true, une position peut alors n'avoir AUCUNE limite de perte).
CATASTROPHE_STOP_PCT=20

# --- Gestion du risque (garde-fous — jamais retirés, seulement recalibrés) ---
RISK_PER_TRADE_PCT=4.0    # agressif +++ (était 1.0) : % du capital risqué par trade
MAX_POSITION_PCT=60.0     # agressif +++ (était 25.0) : % max du capital sur une position
DAILY_LOSS_CAP_PCT=10.0   # agressif +++ (était 3.0) : perte du jour -> le bot se coupe
MAX_DRAWDOWN_PCT=35.0     # agressif +++ (était 15.0) : baisse depuis le sommet -> le bot se coupe
MIN_ORDER_USDT=11         # taille d'ordre minimale (Binance impose ~10 USDT)
